# ==============================================================================
# SyndicPro Maroc — Sécurité des Téléversements (Uploads)
# ==============================================================================
# Interdire strictement l'exécution de tout script (PHP, CGI, Perl, Python)
# dans les dossiers médias pour prévenir les attaques d'élévation de privilèges.

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Désactiver l'exécution PHP si mod_php est actif
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
